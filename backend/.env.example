# MariaDB connection used by the NestJS application.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=novel_writing_app

# Prisma CLI connection URL. Keep it pointed at the same database as the values above.
DATABASE_URL=mysql://your_database_user:your_database_password@localhost:3306/novel_writing_app

# NestJS server port.
PORT=3001
